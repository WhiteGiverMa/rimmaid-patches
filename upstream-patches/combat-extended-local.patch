diff --git a/ModPatches/Pigeon/Patches/Pigeon/ThingDefs_Races/Pigeon.xml b/ModPatches/Pigeon/Patches/Pigeon/ThingDefs_Races/Pigeon.xml
new file mode 100644
index 000000000..b5b64dc5b
--- /dev/null
+++ b/ModPatches/Pigeon/Patches/Pigeon/ThingDefs_Races/Pigeon.xml
@@ -0,0 +1,71 @@
+<?xml version="1.0" encoding="utf-8"?>
+<Patch>
+
+	<!-- ========== Pigeon (fearl.pigeon) CE Compatibility Patch ========== -->
+	<!-- Fixes NRE in Verb_MeleeAttackCE.DamageInfosToApply caused by vanilla Tool
+	     instead of ToolCE. Converts tools to ToolCE and adds RacePropertiesExtensionCE. -->
+
+	<!-- Add RacePropertiesExtensionCE with Birdlike body shape -->
+	<Operation Class="PatchOperationAddModExtension">
+		<xpath>Defs/ThingDef[defName="Pigeon"]</xpath>
+		<value>
+			<li Class="CombatExtended.RacePropertiesExtensionCE">
+				<bodyShape>Birdlike</bodyShape>
+			</li>
+		</value>
+	</Operation>
+
+	<!-- Add melee stat bases -->
+	<Operation Class="PatchOperationAdd">
+		<xpath>Defs/ThingDef[defName="Pigeon"]/statBases</xpath>
+		<value>
+			<MeleeDodgeChance>0.15</MeleeDodgeChance>
+			<MeleeCritChance>0.01</MeleeCritChance>
+			<MeleeParryChance>0.01</MeleeParryChance>
+		</value>
+	</Operation>
+
+	<!-- Replace vanilla tools with ToolCE versions -->
+	<Operation Class="PatchOperationReplace">
+		<xpath>Defs/ThingDef[defName="Pigeon"]/tools</xpath>
+		<value>
+			<tools>
+				<li Class="CombatExtended.ToolCE">
+					<label>claws</label>
+					<capacities>
+						<li>Scratch</li>
+					</capacities>
+					<power>2</power>
+					<cooldownTime>1.5</cooldownTime>
+					<linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
+					<armorPenetrationSharp>0.06</armorPenetrationSharp>
+					<armorPenetrationBlunt>0.1</armorPenetrationBlunt>
+				</li>
+				<li Class="CombatExtended.ToolCE">
+					<label>beak</label>
+					<capacities>
+						<li>Bite</li>
+					</capacities>
+					<power>3</power>
+					<cooldownTime>2</cooldownTime>
+					<linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
+					<armorPenetrationSharp>0.01</armorPenetrationSharp>
+					<armorPenetrationBlunt>0.1</armorPenetrationBlunt>
+				</li>
+				<li Class="CombatExtended.ToolCE">
+					<label>head</label>
+					<capacities>
+						<li>Blunt</li>
+					</capacities>
+					<power>1</power>
+					<cooldownTime>1.5</cooldownTime>
+					<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
+					<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
+					<chanceFactor>0.2</chanceFactor>
+					<armorPenetrationBlunt>0.1</armorPenetrationBlunt>
+				</li>
+			</tools>
+		</value>
+	</Operation>
+
+</Patch>
\ No newline at end of file
