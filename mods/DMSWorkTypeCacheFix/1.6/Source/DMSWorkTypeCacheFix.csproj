<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DMSWorkTypeCacheFix</AssemblyName>
    <RootNamespace>Meidocho.DMSWorkTypeCacheFix</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>bin\</OutputPath>
    <GameRoot>A:\SteamLibrary\steamapps\common\RimWorld</GameRoot>
    <PatchRoot>$(MSBuildProjectDirectory)\..\..\</PatchRoot>
    <DeployRoot>A:\SteamLibrary\steamapps\common\RimWorld\Mods\DMSWorkTypeCacheFix</DeployRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>A:\SteamLibrary\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployLocalPatch" AfterTargets="Build" Condition="'$(DeployLocal)'=='true'">
    <MakeDir Directories="$(DeployRoot)\About;$(DeployRoot)\1.6\Assemblies" />
    <Copy SourceFiles="$(PatchRoot)About\About.xml" DestinationFolder="$(DeployRoot)\About" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployRoot)\1.6\Assemblies" />
  </Target>
</Project>
