<ModMetaData>
  <name>失能机关：机兵封存 / DMS Mech Storage</name>
  <author>WhiteGiverMa</author>
  <packageId>whitegiver.dms.mechstorage</packageId>
  <modVersion>1.1.4</modVersion>
  <supportedVersions><li>1.7</li></supportedVersions>
  <modDependencies>
    <li><packageId>brrainz.harmony</packageId><displayName>Harmony</displayName><steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl></li>
