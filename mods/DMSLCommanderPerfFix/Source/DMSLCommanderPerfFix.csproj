    <RootNamespace>WhiteGiver.DMSL.CommanderPerfFix</RootNamespace>
    <GameRoot Condition="'$(GameRoot)' == ''">A:\SteamLibrary\steamapps\common\RimWorld</GameRoot>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <LegionPath Condition="'$(LegionPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\3666117000\1.7\Assemblies\DMS_Legion.dll</LegionPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
