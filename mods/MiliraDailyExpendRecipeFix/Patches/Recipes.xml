<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!--
    Milira Daily Expend: cooking recipes fall back to IngredientValueGetter_Volume
    because none of them sets ingredientValueGetterClass. This patch:
      1. reprices the two NeverForNutrition intermediates to their ingredient cost;
      2. switches the 20 pure-food recipes to IngredientValueGetter_Nutrition;
      3. rewrites every count as a nutrition value that preserves the intended item cost;
      4. fixes the bulk soy sauce ratio and the three over-generous recipes.
    Recipes that use inedible ingredients (SunLightFuel, SunPlateSteel) keep the
    volume getter on purpose: IngredientValueGetter_Nutrition divides by zero for them.
  -->

  <!-- ===== intermediates: nutrition value = ingredient cost ===== -->

  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Milira_SunLightSoySauce"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.1</Nutrition>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="Milira_SunLightFruitJam"]/statBases/Nutrition</xpath>
    <value>
      <Nutrition>0.1</Nutrition>
    </value>
  </Operation>

  <!-- ===== Calidor bento ===== -->

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName="Milira_MakeCalidorBento"]</xpath>
    <value>
      <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/RecipeDef[defName="Milira_MakeCalidorBento"]/ingredients/li[1]/count</xpath>
    <value>
      <count>0.25</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/RecipeDef[defName="Milira_MakeCalidorBento"]/ingredients/li[2]/count</xpath>
    <value>
      <count>0.1</count>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/RecipeDef[defName="Milira_MakeCalidorBento"]/ingredients/li[3]/count</xpath>
    <value>
      <count>0.25</count>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/RecipeDef[defName="Milira_MakeMoreCalidorBento"]</xpath>
