<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>The Dead Man's Switch - Synthetic</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DMS_Mech_Lady"]/comps[not(li[@Class="CompProperties_MechRepairable"])]</xpath>
					<value>
						<li Class="CompProperties_MechRepairable" />
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DMS_Mech_Maiden"]/comps[not(li[@Class="CompProperties_MechRepairable"])]</xpath>
					<value>
						<li Class="CompProperties_MechRepairable" />
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DMS_Mech_Armiman"]/comps[not(li[@Class="CompProperties_MechRepairable"])]</xpath>
					<value>
						<li Class="CompProperties_MechRepairable" />
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="DMS_Mech_BigSister"]/comps[not(li[@Class="CompProperties_MechRepairable"])]</xpath>
					<value>
						<li Class="CompProperties_MechRepairable" />
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
