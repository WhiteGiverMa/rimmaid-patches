<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WorldObjectDef[defName="DMSE_MissileBase" or defName="DMSE_FieldLaunchSite" or defName="DMSE_EarlyLaunchSite"]/validLaunchTarget</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/WorldObjectDef[defName="DMSE_MissileBase" or defName="DMSE_FieldLaunchSite" or defName="DMSE_EarlyLaunchSite"]/validLaunchTarget</xpath>
      <value>
        <validLaunchTarget>true</validLaunchTarget>
      </value>
    </match>
  </Operation>
</Patch>
