<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="FTC_BasePermanentStructure">
    <defName>WhiteGiver_SunlightFuelGeneratorFacility</defName>
    <label>sunlight fuel generator facility</label>
    <description>A large permanent facility that burns solar fuel to generate electricity. It uses the citadel chemfuel generator's art and footprint, but only accepts solar fuel.\n\nPower output, fuel capacity and daily fuel consumption can be adjusted in Mod Settings and apply immediately to existing buildings.\n\nThis is a permanent structure and cannot be deconstructed once built.</description>
    <thingClass>Building</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/FortGenerator/Generator</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(9,5)</drawSize>
      <shadowData>
        <volume>(1.93,1,1.69)</volume>
        <offset>(-0.03,0,-0.1)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>150</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0.05</Flammability>
      <Beauty>-10</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <canOverlapZones>false</canOverlapZones>
    <size>(7,3)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
      <deconstructible>false</deconstructible>
      <claimable>true</claimable>
    </building>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
      <FT_ConcreteCompressed>10</FT_ConcreteCompressed>
      <Milira_SolarCrystal>20</Milira_SolarCrystal>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-7500</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
        <soundAmbientProducingPower>ChemfuelFiredGenerator_Ambience</soundAmbientProducingPower>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.22</fuelConsumptionRate>
        <fuelCapacity>400.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>Milira_SunLightFuel</li>
          </thingDefs>
        </fuelFilter>
        <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
        <initialConfigurableTargetFuelLevel>400</initialConfigurableTargetFuelLevel>
        <canEjectFuel>true</canEjectFuel>
        <autoRefuelPercent>0.8</autoRefuelPercent>
        <drawFuelGaugeInMap>true</drawFuelGaugeInMap>
        <showFuelGizmo>true</showFuelGizmo>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(80,112,180,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>30</heatPerSecond>
      </li>
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Explosive">
        <explosiveRadius>0</explosiveRadius>
        <explosiveExpandPerFuel>0.03125</explosiveExpandPerFuel>
        <explosiveDamageType>Flame</explosiveDamageType>
        <destroyThingOnExplosionSize>7</destroyThingOnExplosionSize>
        <startWickHitPointsPercent>0.05</startWickHitPointsPercent>
        <preExplosionSpawnThingDef>Filth_Fuel</preExplosionSpawnThingDef>
        <preExplosionSpawnChance>1</preExplosionSpawnChance>
        <wickTicks>150~300</wickTicks>
      </li>
    </comps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Power</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>FTC_PermanentStructure</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
    <uiOrder>2100</uiOrder>
  </ThingDef>
</Defs>
