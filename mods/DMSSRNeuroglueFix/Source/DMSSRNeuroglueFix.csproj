<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <AssemblyName>DMSSRNeuroglueFix</AssemblyName>
    <RootNamespace>WhiteGiver.DMSSRNeuroglueFix</RootNamespace>
    <GameRoot Condition="'$(GameRoot)' == ''">A:\SteamLibrary\steamapps\common\RimWorld</GameRoot>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\2009463077\1.7\Assemblies\0Harmony.dll</HarmonyPath>
    <DmsPath Condition="'$(DmsPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\3819799478\1.7\Assemblies\DMS.dll</DmsPath>
    <DmssrPath Condition="'$(DmssrPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\3835512735\1.7\Assemblies\DMSSR.dll</DmssrPath>
    <FortifiedPath Condition="'$(FortifiedPath)' == ''">A:\SteamLibrary\steamapps\workshop\content\294100\3498575851\1.7\Assemblies\Fortified.dll</FortifiedPath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Validation</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameRoot)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameRoot)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DMS" Condition="Exists('$(DmsPath)')">
      <HintPath>$(DmsPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DMSSR">
      <HintPath>$(DmssrPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Fortified" Condition="Exists('$(FortifiedPath)')">
      <HintPath>$(FortifiedPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\1.7\Assemblies" />
  </Target>
</Project>
